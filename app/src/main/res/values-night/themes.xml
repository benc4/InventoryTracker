<resources>
    <style name="Base.Theme.InventoryTracker" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorTertiary">@color/blue_tertiary</item>
        <item name="contentColor">@color/white</item>
        <item name="disabledColor">@color/disabled_gray_dark</item>
        <item name="textColorError">@color/error_text_light</item>
        <item name="textColorSuccess">@color/success_text_light</item>
        <item name="cardBackgroundColor">@color/card_background_dark</item>

        <item name="textAppearanceLabelLarge">@style/CustomTextAppearance.LabelLarge</item>
    </style>

    <style name="CustomTextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/faint_blue</item>
    </style>
</resources>