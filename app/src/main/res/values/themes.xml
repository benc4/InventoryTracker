<resources>
    <style name="Base.Theme.InventoryTracker" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorSecondary">@color/purple_secondary</item>
        <item name="colorTertiary">@color/pink_tertiary</item>
        <item name="contentColor">@color/black</item>
        <item name="disabledColor">@color/disabled_gray_light</item>
        <item name="textColorError">@color/error_text_dark</item>
        <item name="textColorSuccess">@color/success_text_dark</item>
        <item name="cardBackgroundColor">@color/card_background_light</item>

        <item name="textAppearanceLabelLarge">@style/CustomTextAppearance.LabelLarge</item>
    </style>

    <style name="CustomTextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grayish_purple</item>
    </style>

    <style name="Theme.InventoryTracker" parent="Base.Theme.InventoryTracker" />
</resources>